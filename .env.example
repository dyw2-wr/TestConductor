# Copy to .env for local development. Never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-random-local-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
TEST_PLATFORM_ARTIFACT_ROOT=run_artifacts
TEST_PLATFORM_LLM_API_KEY=
TEST_PLATFORM_LLM_BASE_URL=
TEST_PLATFORM_LLM_MODEL=
# Optional: leave empty to inherit TEST_PLATFORM_LLM_MODEL.
TEST_PLATFORM_DESIGN_LLM_MODEL=
TEST_PLATFORM_PLANNING_LLM_MODEL=
TEST_PLATFORM_LLM_TIMEOUT_SECONDS=120
TEST_PLATFORM_LLM_CONNECT_TIMEOUT_SECONDS=10
TEST_PLATFORM_LLM_MAX_RETRIES=0
TEST_PLATFORM_LLM_MAX_CONCURRENT_CALLS=2
TEST_PLATFORM_LLM_QUEUE_TIMEOUT_SECONDS=15
DB_SQLITE_TIMEOUT_SECONDS=20
PROCEDURE_JOB_API_TOKEN=
TEST_PLATFORM_PROCEDURE_DISCOVERY_ENABLED=false
TEST_PLATFORM_RUNTIME_CONTEXT_FACTORY=
TEST_PLATFORM_RUNTIME_CONTEXT_JSON=
TEST_PLATFORM_MILVUS_ENABLED=false
TEST_PLATFORM_MILVUS_URI=http://localhost:19530
TEST_PLATFORM_MILVUS_TOKEN=
TEST_PLATFORM_MILVUS_DATABASE=default
TEST_PLATFORM_MILVUS_COLLECTION=test_conductor_knowledge_v1
TEST_PLATFORM_MILVUS_DENSE_WEIGHT=0.65
TEST_PLATFORM_MILVUS_SPARSE_WEIGHT=0.35
TEST_PLATFORM_EMBEDDING_DEVICE=cpu
TEST_PLATFORM_EMBEDDING_PROVIDER=hashing
TEST_PLATFORM_APPROVED_KNOWLEDGE_CATALOG=
