      "max_duration_seconds": 5,
      "max_virtual_users": 10,
      "observables": [
        {
          "observable_ref": "observable.perf.demo-p95",
          "description": "HTTP latency percentile",
          "metric": "latency_ms",
          "unit": "ms",
          "percentile": "p95"
        }
      ]
    }
  ],
  "procedure_profiles": [
    {
      "profile_ref": "procedure.demo.home",
      "site": "demo.local",
      "library_id": "site.demo.local",
