{
  "schema_version": "planning-catalog.v4",
  "catalog_id": "catalog.test_conductor-demo.local.v4",
  "system_id": "test_conductor-demo",
  "environment": "local",
  "available_executors": ["procedure_playwright", "http_api", "database", "performance", "tcp_port"],
  "http_operations": [
    {
      "operation_ref": "http.demo.health",
      "description": "Read the local health endpoint",
      "base_url_ref": "runtime.demo.http",
      "method": "GET",
      "path": "/health",
      "state_effect": "read_only",
      "observables": [
        {
          "observable_ref": "observable.http.demo-status",
          "description": "HTTP status code",
          "kind": "status"
        }
      ]
    }
  ],
  "database_operations": [
    {
      "operation_ref": "db.demo.status",
      "description": "Read the local service status row",
      "connection_profile_ref": "runtime.demo.db",
      "operation_kind": "query",
      "execution_policy": "read_only",
      "state_effect": "read_only",
      "observables": [
        {
          "observable_ref": "observable.db.demo-status",
          "description": "Service status value",
          "kind": "column",
          "column": "status"
        }
      ]
    }
  ],
  "tcp_port_probes": [
    {
      "probe_ref": "port.demo.service",
      "description": "Connect to the one explicitly registered local TCP service",
      "host_ref": "runtime.demo.tcp",
      "port": 1,
      "timeout_seconds": 1.0,
      "state_effect": "read_only",
      "observables": [
        {
          "observable_ref": "observable.port.demo-state",
          "description": "TCP connection state",
          "kind": "state"
        }
      ]
    }
  ],
  "performance_profiles": [
    {
      "profile_ref": "perf.demo.smoke",
      "description": "Small local HTTP load profile for a smoke check",
      "driver_ref": "driver.demo.http",
